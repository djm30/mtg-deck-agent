# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# ── LLM: any OpenAI-compatible Chat Completions API ─────────────────
# API key / bearer token from your LLM provider
OPENAI_API_KEY=
# Base URL up to and including /api/v1 (the client appends /chat/completions)
# e.g. https://<llm-host>/api/v1
OPEN_AI_BASE_URL=
# Model ID as your provider names it
MODEL=

# ── LangSmith tracing ───────────────────────────────────────────────
# API key: smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGSMITH_AGENT_ID=mtg-agent
LANGSMITH_AGENT_ENVIRONMENT=local
